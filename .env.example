# ───────────────────────────── Site ─────────────────────────────
# Origem usada em canonical, hreflang, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=https://www.3wsmoldes.com.br

# ─────────────────────────── Supabase ───────────────────────────
# Sem estas duas, o site continua de pé servindo o acervo em arquivo
# (public/acervo + catalog.generated.json) e o /admin fica fechado.
# Com elas, o Supabase passa a ser a fonte oficial do estoque.
#
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEGREDO. Ignora a RLS por completo.
# Usada só pelo script de importação do acervo, nunca pelo navegador.
# Jamais prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
